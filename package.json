{
  "name": "wuwatappo-full-community",
  "version": "1.4.1-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract-assets.mjs",
    "inventory": "node macos/scripts/inventory-contract.mjs",
    "icons": "node macos/scripts/app.mjs icons",
    "prepare:frontend": "node macos/scripts/prepare-frontend.mjs",
    "dev": "node macos/scripts/app.mjs dev",
    "build": "node macos/scripts/app.mjs build",
    "build:mac": "node scripts/build-platform.mjs --platform=mac",
    "build:win": "node scripts/build-platform.mjs --platform=win",
    "build:all": "node scripts/build-platform.mjs --platform=all",
    "build:check": "node scripts/build-platform.mjs --check",
    "test:shared": "node scripts/sync-frontend.mjs --check && node shared/tests/host-routes.cjs && node shared/tests/chest-input.cjs && node shared/tests/balance-threshold.cjs && node shared/tests/dashboard-and-emote.cjs && node --test macos/tests/frontend-sync.test.mjs macos/tests/fullatlas-controller.test.mjs macos/tests/fullatlas-mod.test.mjs macos/tests/loading-gate.test.mjs macos/tests/regions.test.mjs macos/tests/release-assets.test.mjs macos/tests/repo-layout.test.mjs macos/tests/upstream-baseline.test.mjs macos/tests/upstream-baseline-automation.test.mjs",
    "test:mac": "node --test macos/tests/*.test.mjs",
    "test:win": "node windows/src/tests/test_controller_bootstrap.cjs && node windows/src/tests/test_desktop_assistant.cjs && node windows/src/tests/test_initialize.cjs",
    "test": "npm run test:shared && npm run test:mac && npm run test:win",
    "test:rust": "node macos/scripts/app.mjs test:rust",
    "sync:frontend": "node scripts/sync-frontend.mjs --check",
    "assets:sync": "node scripts/sync-upstream.mjs",
    "upstream:check": "node scripts/sync-upstream.mjs --check",
    "upstream:update": "node scripts/sync-upstream.mjs --update-lock",
    "official:update": "node macos/scripts/update-official.mjs",
    "setup": "npm run assets:sync && npm run icons && npm run prepare:frontend",
    "package": "bash macos/scripts/package-macos.sh",
    "setup:global": "WUWA_REGION=global npm run setup",
    "dev:global": "WUWA_REGION=global npm run dev",
    "build:global": "WUWA_REGION=global npm run build",
    "package:global": "WUWA_REGION=global npm run package",
    "test:fullatlas": "node --test macos/tests/fullatlas*.test.mjs && node shared/tests/chest-input.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "acorn": "^8.15.0",
    "js-beautify": "^1.15.4",
    "terser": "^5.44.0"
  }
}
