# 依赖与两平台共用的产物目录（macOS 与 Windows 都往 dist/ 交付）
/node_modules/
/dist/
/.work/
/outputs/
/release-assets/
.env
.env.*
!.env.example
*.p12
*.p8
.DS_Store

# macOS 侧（源码在 macos/，构建产物与缓存不入库）
/macos/frontend/
/macos/frontend-global/
/macos/build/
/macos/.work/
/macos/.cargo-check.log
/macos/.work-build.log
/macos/.workflow/
/macos/work/
/macos/src-tauri/target/
/macos/src-tauri/icons/
/macos/src-tauri/icons-global/
/macos/src-tauri/gen/

# Windows 侧产物与缓存（源码在 windows/，构建产物不入库）
/windows/app/
/windows/build/
# 国际服一套独立目录，结构相同
/windows/app-global/
/windows/build-global/
/windows/dist/
/windows/.venv/
# 临时目录：从这里取 CI 产物、解包、试装。里面有 100MB 级安装包，
# 一旦被 git add -A 带进来会让 push 直接被 GitHub 的 100MB 限制拒掉。
/windows/.work/
/windows/assets/
/windows/runtime/
/windows/cache/
/windows/cache_*/
/windows/*.log
/windows/local_config.json
/windows/offline_state.json
/windows/assistant_state.json
__pycache__/
*.pyc

# 本地工作区记忆与工具数据
/.workbuddy/
.idea/
